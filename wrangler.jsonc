{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "englishapp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding; the service name must match the worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "englishapp"
    }
  ],
  // Workers AI, used for speech-to-text in the speaking practice.
  "ai": { "binding": "AI" },
  // Accounts, sessions, AI usage and synced progress (docs/accounts.md).
  "d1_databases": [
    { "binding": "DB", "database_name": "englishapp", "database_id": "06cc5b8e-84fb-43cd-9944-2b8b7e3e2438" }
  ],
  // Keep variables set in the dashboard (ADMIN_EMAILS) when deploying.
  "keep_vars": true,
  "observability": { "enabled": true }
}
