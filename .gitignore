# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source books for lesson writing (copyrighted, never commit)
/sources/

# Downloaded vocabulary sources (tools/vocab/fetch.sh)
/data/raw/
/public/data/vocab/
/public/data/grammar/

# Cloudflare build output and local secrets
/.open-next/
/.wrangler/
.dev.vars*

# Python
__pycache__/
