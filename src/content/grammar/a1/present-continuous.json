        {
          "label": "Có từ để hỏi",
          "text": "Wh- + [be] + chủ ngữ + V-ing?"
        }
      ],
      "body": [],
      "examples": [
        {
          "en": "I'm [[not working]] today.",
          "vi": "Hôm nay tôi không làm việc.",
          "why": "Not đứng sau be."
        },
        {
          "en": "[[Is]] it [[raining]]?",
          "vi": "Trời có đang mưa không?",
          "why": "Is lên đầu câu."
        },
        {
          "en": "What [[are]] you [[doing]]?",
          "vi": "Bạn đang làm gì?",
          "why": "Wh- + are + you + doing."
