  "mistakes": [
    {
      "wrong": "I eating now.",
      "right": "I am eating now.",
      "why": "Thiếu be."
    },
    {
      "wrong": "She is cook dinner.",
      "right": "She is cooking dinner.",
      "why": "Thiếu -ing."
    },
    {
      "wrong": "Are you understand?",
      "right": "Do you understand?",
      "why": "Understand không dùng tiếp diễn → hỏi bằng do."
    },
    {
      "wrong": "They is playing.",
      "right": "They are playing.",
      "why": "They → are."
    },
    {
      "wrong": "I am wanting a coffee.",
      "right": "I want a coffee.",
      "why": "Want không dùng -ing."
    }
  ],
