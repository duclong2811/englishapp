  "title": "Giới từ chỉ thời gian: in, on, at",
  "summary": "At + giờ, on + ngày, in + tháng, năm, mùa; các cụm cố định và khi nào không dùng giới từ.",
  "dialogue": [
    {
      "who": "A",
      "en": "When is your birthday?",
      "vi": "Sinh nhật bạn khi nào?"
    },
    {
      "who": "B",
      "en": "It's [[in]] June, [[on]] June the twelfth.",
      "vi": "Vào tháng Sáu, ngày mười hai."
    },
    {
      "who": "A",
      "en": "That's a Saturday this year! Let's have a party [[on]] Saturday evening.",
